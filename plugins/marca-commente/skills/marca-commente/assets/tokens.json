  "$acentos-escuros-nota": "Cada acento claro tem par escuro: é ele que faz de texto e de ponto sobre branco. O acento claro nunca faz — ver a regra de acessibilidade.",
  "superficie-noche": {
    "$nota": "Superfície própria de llmbattle.dev. Matiz 287° (o da lavanda), luminosidade 0,30. NÃO é tema do sistema e não se empresta às outras oito marcas.",
    "marca": "llmbattle.dev",
    "ativacao": "data-superficie=\"noche\"",
    "noche": "#2C2B40",
    "noche-elevada": "#35334B",
    "noche-borde": "#423F63",
    "noche-texto": "#F1F1FA",
    "noche-texto-suave": "#AFAEC7",
    "noche-acento-texto": "#A59AFF",
    "regras": [
      "O ladrillo mantém o azul #005278 e ganha borda #423F63 para se descolar do fundo.",
      "O ponto passa à lavanda plena #9B8CFF, nunca à versão escura.",
      "A ação vai em lavanda com texto em tinta #1A1A1A.",
      "O texto de acento usa #A59AFF, não a lavanda de preenchimento: #9B8CFF sobre a noche elevada dá 4,4:1 e não passa o mínimo de 4,5:1."
    ]
  },
  "acessibilidade": {
    "minimo": "Texto ≥ 4,5:1 contra o fundo real; 3:1 só em escala de titular.",
    "acento-claro-nunca-texto": "Nenhum acento claro (amarillo, amarillo inmmerce, ámbar, jade, azul claro, gris, lavanda) serve de cor de texto sobre branco: ou vai como fundo com texto em --sobre-acento, ou usa a versão escura.",
    "rosa": "Texto branco sobre rosa #FF245E dá 3,71:1 e não passa. Sobre rosa o texto vai em tinta #1A1A1A (4,7:1).",
    "rotulos": "Rótulo de 10–11px nunca leva cor de acento: leva tinta sobre um chip do acento.",
    "hit-target": "≥ 44px"
  }
